# FulfillFlow WMS Backend Environment Variables Example
# Copy this file to .env and customize values for your environment

# Application Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:4200

# Database Configuration (PostgreSQL)
# For local development (outside Docker), use port 5434
# For Docker Compose, use host 'postgres' and port 5432
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=fulfillflow
DB_PASSWORD=fulfillflow
DB_DATABASE=fulfillflow

# Redis Configuration
# For local development (outside Docker), use localhost:6379
# For Docker Compose, use host 'redis' and port 6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Docker Compose Note:
# When running with Docker Compose, the following values in docker-compose.yml
# override the .env file:
# - DB_HOST=postgres (container name)
# - REDIS_HOST=redis (container name)
# - DB_PORT=5432 (internal container port)
